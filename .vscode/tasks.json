{
	"version": "2.0.0",
	"tasks": [
		{
			// Manual "lint the whole project" fallback (Cmd+Shift+B) — same gdtoolkit
			// gdlint + .gdlintrc as CI. Live per-file linting is handled by the
			// EddieDover extension; this is here for a full-project sweep on demand.
			"label": "gdlint",
			"type": "shell",
			"command": "./lint.sh",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent",
				"clear": true
			},
			"problemMatcher": {
				"owner": "gdlint",
				"source": "gdlint",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": {
					"regexp": "^(.+?):(\\d+): (Error|Warning): (.+)$",
					"file": 1,
					"line": 2,
					"severity": 3,
					"message": 4
				}
			}
		}
	]
}
