{
	// LINTING — single source of truth, live in the editor AND identical to CI:
	// EddieDover.gdscript-formatter-linter runs the system gdtoolkit `gdlint`, which
	// reads .gdlintrc — the exact same tool and config file CI uses. gdlintPath is
	// set explicitly because a macOS GUI app may not inherit ~/.local/bin on PATH
	// (pipx install location); adjust if gdtoolkit lives elsewhere.
	"godotFormatterAndLinter.gdlintPath": "/Users/drew/.local/bin/gdlint",

	// dohe.godot-format ships a DIFFERENT linter (GDQuest, its own rules) — keep it
	// off so there's one linter, and it's the one that matches CI.
	"godotFormatter.enableLinter": false,

	// FORMATTING stays on dohe (GDQuest); our files are already in that style, and
	// formatting isn't CI-gated. Pin it as the default so the two installed
	// formatters (dohe + EddieDover) don't conflict.
	"[gdscript]": {
		"editor.defaultFormatter": "dohe.godot-format"
	}
}
