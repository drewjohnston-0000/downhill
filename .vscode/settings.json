{
	// Single source of truth for linting = gdlintrc, read by gdtoolkit gdlint.
	// CI runs it; the editor runs the SAME tool against the SAME file via the
	// on-save task below. CI cannot read VSCode settings, so NO lint rule is
	// configured here — that would be a second config CI is blind to.

	// Turn off dohe.godot-format's own bundled linter so it can't emit a second,
	// conflicting set of warnings from a config CI never sees.
	"godotFormatter.enableLinter": false,

	// Live linting: Trigger Task on Save (Gruntfuggly.triggertaskonsave) runs the
	// "gdlint" task (tasks.json) on every .gd save; its problem matcher paints
	// results into the Problems panel — same gdtoolkit + gdlintrc as CI.
	"triggerTaskOnSave.tasks": {
		"gdlint": ["**/*.gd"]
	},
	"triggerTaskOnSave.showStatusBarToggle": true,
	"triggerTaskOnSave.restart": true
}
